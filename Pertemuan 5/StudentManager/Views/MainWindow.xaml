<Window x:Class="StudentManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StudentManager.ViewModels"
        Title="Student Manager"
        Height="720"
        Width="1180"
        MinHeight="620"
        MinWidth="1000"
        Background="#F5EFE6"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="24">

        <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <!-- HEADER -->
<Border Grid.Row="0"
        Background="#D8C3A5"
        CornerRadius="18"
        Padding="16"
        Margin="0,0,0,12">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- JUDUL -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

            <TextBlock Text="Student Manager"
                       FontSize="26"
                       FontWeight="Bold"/>

            <TextBlock Text="Kelola data mahasiswa dengan mudah"
                       FontSize="14"
                       Margin="0,3,0,0"/>

        </StackPanel>


        <!-- STATISTIK KECIL -->
        <Border Grid.Column="1"
                Background="#F7F2EA"
                CornerRadius="12"
                Padding="12,7"
                Margin="20,0,0,0">

            <StackPanel>

                <TextBlock Text="INFORMASI STATISTIK"
                           FontSize="11"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>

                    <!-- KIRI -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Total"
                                   FontSize="10"/>

                        <TextBlock Text="{Binding TotalStudents}"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Informatika"
                                   FontSize="10"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="{Binding InformatikaCount}"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Laki-laki"
                                   FontSize="10"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="{Binding LakiLakiCount}"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                    </StackPanel>


                    <!-- KANAN -->
                    <StackPanel Grid.Column="1">

                        <TextBlock Text="Total"
                                   FontSize="10"
                                   Foreground="Transparent"/>

                        <TextBlock Text=" "
                                   FontSize="18"/>

                        <TextBlock Text="S. Informasi"
                                   FontSize="10"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="{Binding SistemInformasiCount}"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Perempuan"
                                   FontSize="10"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="{Binding PerempuanCount}"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </Grid>

            </StackPanel>

        </Border>

    </Grid>

</Border>


        <!-- SEARCH -->
<Grid Grid.Row="1" Margin="0,0,0,10">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <TextBox Grid.Column="0"
             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
             Height="34"
             Padding="10,0"
             VerticalContentAlignment="Center"
             ToolTip="Cari berdasarkan NIM, nama, atau program studi"/>

    <Button Grid.Column="1"
            Content="Refresh"
            Command="{Binding RefreshCommand}"
            Height="34"
            Width="85"
            Margin="10,0,0,0"/>

</Grid>


        <!-- FORM + DATA GRID -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- FORM MAHASISWA -->
<Border Grid.Column="0"
        Background="#FBF8F3"
        CornerRadius="16"
        Padding="14">

    <StackPanel>

        <TextBlock Text="Form Mahasiswa"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <TextBlock Text="NIM"/>
        <TextBox Text="{Binding Nim, UpdateSourceTrigger=PropertyChanged}"
                 Height="30"/>

        <TextBlock Text="Nama"/>
        <TextBox Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"
                 Height="30"/>

        <TextBlock Text="Program Studi"/>
        <TextBox Text="{Binding Prodi, UpdateSourceTrigger=PropertyChanged}"
                 Height="30"/>

        <TextBlock Text="Jenis Kelamin"/>

        <ComboBox SelectedValue="{Binding JenisKelamin, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Content"
                  Height="30">

            <ComboBoxItem Content="Laki-laki"/>
            <ComboBoxItem Content="Perempuan"/>

        </ComboBox>

        <TextBlock Text="Gmail"/>
        <TextBox Text="{Binding Gmail, UpdateSourceTrigger=PropertyChanged}"
                 Height="30"/>

        <WrapPanel Margin="0,10,0,0">

            <Button Content="Simpan"
                    Command="{Binding AddCommand}"
                    Height="32"
                    Width="70"
                    Margin="0,0,7,0"/>

            <Button Content="Edit"
                    Command="{Binding UpdateCommand}"
                    Height="32"
                    Width="60"
                    Margin="0,0,7,0"/>

            <Button Content="Hapus"
                    Command="{Binding DeleteCommand}"
                    Height="32"
                    Width="60"
                    Margin="0,0,7,0"/>

            <Button Content="Reset"
                    Command="{Binding ResetCommand}"
                    Height="32"
                    Width="60"/>

        </WrapPanel>

    </StackPanel>

</Border>


            <!-- DATA MAHASISWA -->
            <Border Grid.Column="2"
                    Background="#FBF8F3"
                    CornerRadius="16"
                    Padding="18">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal">

                        <TextBlock Text="Daftar Mahasiswa"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="  •  Klik baris untuk mengedit"
                                   Margin="8,0,0,3"/>

                    </StackPanel>


                    <DataGrid Grid.Row="1"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="NIM"
                                                Binding="{Binding Nim}"
                                                Width="130"/>

                            <DataGridTextColumn Header="Nama"
                                                Binding="{Binding Nama}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Program Studi"
                                                Binding="{Binding Prodi}"
                                                Width="170"/>

                            <DataGridTextColumn Header="Jenis Kelamin"
                                                Binding="{Binding JenisKelamin}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Gmail"
                                                Binding="{Binding Gmail}"
                                                Width="210"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>